# Resolve paths relative to this package so isolated and relocated installs work.
get_filename_component(_onnxruntime_ros_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(onnxruntime_ros_INCLUDE_DIRS "${_onnxruntime_ros_prefix}/include/onnxruntime_ros")
set(onnxruntime_ros_CUDA_ENABLED "@onnxruntime_ros_CUDA_ENABLED@")

# Same target name as the upstream ONNX Runtime CMake config and onnxruntime_vendor
if(NOT TARGET onnxruntime::onnxruntime)
  add_library(onnxruntime::onnxruntime SHARED IMPORTED)
  set_target_properties(onnxruntime::onnxruntime PROPERTIES
    IMPORTED_LOCATION "${_onnxruntime_ros_prefix}/lib/libonnxruntime.so"
    INTERFACE_INCLUDE_DIRECTORIES "${onnxruntime_ros_INCLUDE_DIRS}"
  )
endif()

if(NOT TARGET onnxruntime_ros::onnxruntime_ros)
  add_library(onnxruntime_ros::onnxruntime_ros INTERFACE IMPORTED)
  set_target_properties(onnxruntime_ros::onnxruntime_ros PROPERTIES
    INTERFACE_LINK_LIBRARIES onnxruntime::onnxruntime
  )
endif()

set(onnxruntime_ros_LIBRARIES onnxruntime_ros::onnxruntime_ros)
unset(_onnxruntime_ros_prefix)
